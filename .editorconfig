root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.py]
indent_size = 4
max_line_length = 100

[*.{md,markdown}]
indent_size = 2
max_line_length = 90
trim_trailing_whitespace = false

[*.{json,yml,yaml,toml,ini,cfg}]
indent_size = 2

[*.{html,css,js,ts}]
indent_size = 2

[*.sql]
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab

[*.txt]
max_line_length = off
